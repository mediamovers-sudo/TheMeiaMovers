# ==========================================================
# The MediaMovers — Backend Environment Variables
# ==========================================================
# Copy this file to .env and provide your values.

# Database — Supabase Postgres Connection String
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres?sslmode=require"

# JWT Secret — generate a strong random 32+ character string
JWT_SECRET="generate_a_random_secure_jwt_secret"

# Initial Admin User Credentials
# Automatically created on server startup only if no admin user exists in DB
ADMIN_EMAIL="mediamovers@nist.edu"
ADMIN_PASSWORD="ChooseAStrongPassword123!"

# Server Configuration
PORT=5000
NODE_ENV="production"

# Cloudinary Storage (for image uploads in admin panel)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# CORS — Allowed Origins (comma-separated). Keep localhost for dev; set your Render URL in production
ALLOWED_ORIGINS="https://themeiamoversnist.onrender.com,http://localhost:5000"
FRONTEND_URL="https://themeiamoversnist.onrender.com"

