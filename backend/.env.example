# ==========================================================
# The MediaMovers — Backend Environment Variables
# ==========================================================
# Copy this file to .env and fill in values.

# DATABASE_URL — SQLite (default, zero-dependency):
DATABASE_URL="file:./dev.db"
# For PostgreSQL, replace with:
# DATABASE_URL="postgresql://user:password@localhost:5432/mediamovers?schema=public"
# Also change schema.prisma datasource provider from "sqlite" to "postgresql"

# JWT Secret — use a strong random string in production
JWT_SECRET="change_me_to_a_random_secret"

# Initial Admin Credentials — seeded on first startup if no admin exists
ADMIN_EMAIL="admin@mediamovers.nist.edu"
ADMIN_PASSWORD="ChangeThisPassword!"

# Server
PORT=5000
NODE_ENV="development"

# CORS — set to your actual frontend URL in production
FRONTEND_URL="http://localhost:5000"
